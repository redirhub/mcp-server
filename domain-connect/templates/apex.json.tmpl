{
    "providerId": "${DC_PROVIDER_ID}",
    "providerName": "RedirHub",
    "serviceId": "${DC_SERVICE_ID_APEX}",
    "serviceName": "Custom root domain",
    "version": 1,
    "logoUrl": "${DC_LOGO_URL}",
    "description": "Points a root domain to RedirHub so it can serve redirects and short links with HTTPS.",
    "variableDescription": "%ip%: IPv4 address of the RedirHub edge cluster; %hashid%: RedirHub workspace identifier used in the verification token",
    "syncBlock": false,
    "syncPubKeyDomain": "${DC_KEY_DOMAIN}",
    "syncRedirectDomain": "${DC_REDIRECT_DOMAIN}",
    "records": [
        {
            "type": "A",
            "host": "@",
            "pointsTo": "%ip%",
            "ttl": 600,
            "essential": "OnApply"
        },
        {
            "type": "TXT",
            "host": "@",
            "data": "rehd-verify=%hashid%.${DC_CLUSTER_SUFFIX}",
            "ttl": 600,
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "rehd-verify=",
            "essential": "OnApply"
        }
    ]
}
