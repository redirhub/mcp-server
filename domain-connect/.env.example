# Domain Connect template settings. Copy to .env and fill in; .env is not committed.
# build.sh substitutes these into templates/*.json.tmpl and writes dist/<providerId>.<serviceId>.json
# for submission to github.com/Domain-Connect/Templates.

# Domain we control that identifies RedirHub as a Domain Connect service provider.
DC_PROVIDER_ID=
# Service IDs: one template for subdomains (CNAME), one for root domains (A + TXT).
DC_SERVICE_ID_HOSTNAME=
DC_SERVICE_ID_APEX=
# Domain that holds the public signing key at _dck1.<DC_KEY_DOMAIN>.
DC_KEY_DOMAIN=
# Key host label; the next key for rotation is _dck2.
DC_KEY_HOST=_dck1

# Console domain the signed redirect_uri points to.
DC_REDIRECT_DOMAIN=dash.redirhub.com
# Fixed suffix of the cluster CNAME (cluster.cname without "*.").
DC_CLUSTER_SUFFIX=rediredge.com
# Brand kit SVG from www.redirhub.com/brand.
DC_LOGO_URL=https://dcr3565853rcg.cloudfront.net/brand-kit/v1/svg/redirhub-logo-horizontal.svg
